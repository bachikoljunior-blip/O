@@ -451,6 +456,23 @@ class ZshComplete(ShellComplete):
     name: t.ClassVar[str] = "zsh"
     source_template: t.ClassVar[str] = _SOURCE_ZSH
 
+    def get_completions(
+        self, args: list[str], incomplete: str
+    ) -> list[CompletionItem[str]]:
+        completions = super().get_completions(args, incomplete)
+
+        # Zsh replaces the whole joined word, including the option name.
+        if incomplete.startswith("--") and "=" in incomplete:
+            prefix = incomplete.partition("=")[0] + "="
+            completions = [
+                CompletionItem(
+                    prefix + item.value, type=item.type, help=item.help, **item._info
+                ) if item.type == "plain" else item
+                for item in completions
+            ]
+
+        return completions
+
