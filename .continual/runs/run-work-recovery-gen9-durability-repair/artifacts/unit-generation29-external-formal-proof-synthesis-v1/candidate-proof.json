  "proof": "by\n  refine ⟨(⌊x⌋, Int.fract x), ?_, ?_⟩\n  · exact ⟨(Int.floor_add_fract x).symm, Int.fract_nonneg x, Int.fract_lt_one x⟩\n  · rintro ⟨z, u⟩ ⟨hx, hu0, hu1⟩\n    have hfloor : ⌊x⌋ = z := by\n      rw [Int.floor_eq_iff]\n      constructor <;> linarith\n    apply Prod.ext\n    · exact hfloor.symm\n    · dsimp\n      rw [Int.fract, hfloor]\n      linarith"
